<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- T2 development server runs over HTTP on the experimenter's local network. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
